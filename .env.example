# ------------------------------------------------------------------------------
# 1. SUPABASE (Free Tier: 500MB Database, 50,000 monthly active users)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. CLOUDINARY (Free Tier: 25GB Storage, 25 Credits/mo, Auto WebP/AVIF Delivery)
# Get from: https://cloudinary.com/console
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=og57tmj8
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=dcf_products

# Optional Server-Side Keys (for admin media deletions)
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ------------------------------------------------------------------------------
# 3. STORE ADMIN NOTIFICATIONS & VERIFICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL=dreamcomfortfurniture.in@gmail.com

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY (Test Mode Free)
# Get from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. VERCEL DEPLOYMENT URL (Automatically provided by Vercel in production)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://dreamcomfortfurnitureindia.vercel.app
